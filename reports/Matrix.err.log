def input_matrix(baris, banjar):
    matrix = []
    print(f"Masukkan elemen matriks {baris}x{banjar}:")
    for i in range(baris):
        kolom = []
        for j in range(banjar):
            angka = int(input(f"Masukkan angka [{i+1}][{j+1}]: "))
            kolom.append(angka)
        matrix.append(kolom)
    return matrix


def print_matrix(matrix):
    for kolom in matrix:
        print(" ".join([str(angka) for angka in kolom]))


def penjumlahan_matrix(a, b):
    panjang_a, panjang_b = len(a), len(b[0])
    hasil = [[0] * panjang_b for _ in range(panjang_a)]

    for i in range(panjang_a):
        for j in range(panjang_b):
            hasil[i][j] += a[i][j] + b[i][j]
    return hasil


